telegram_bot_tk=
telegram_chat=
openai_api_k=
log_level=DEBUG
database_file_path=aragorn_db.sqlite
aragorn_tk=
tg_gpt_ig_proxy=

# --- Telegram daily digest ---
# master switch for the scheduled digest jobs
digest_enabled=true
# IANA timezone used for schedule times and the "today" calculation
digest_timezone=Asia/Tehran
# JSON list; each entry: time "HH:MM" 24h (in digest_timezone) + day_offset (0=today, 1=tomorrow, ...)
digest_schedules=[{"time":"12:00","day_offset":0},{"time":"21:00","day_offset":1}]

# --- Channel post links ---
# Public @username of the Aragorn Telegram channel, WITHOUT the leading @.
# Empty -> digest event titles render as plain text (no t.me links).
telegram_channel_username=
openai_model=
instagram_login_cookie=